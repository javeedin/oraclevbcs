{
  "title": "Work orders",
  "description": "Redwood smart search page with a board of work orders created from approved requests: Scheduled, In progress and Completed",
  "variables": {
    "board": {
      "type": "object[]",
      "defaultValue": []
    },
    "stats": {
      "type": "object",
      "defaultValue": {
        "scheduled": 0,
        "inProgress": 0,
        "completed": 0,
        "completedThisWeek": 0
      }
    },
    "all": {
      "type": "object[]",
      "defaultValue": []
    },
    "search": {
      "type": "string",
      "defaultValue": ""
    },
    "searchText": {
      "type": "string",
      "defaultValue": ""
    },
    "subtitle": {
      "type": "string",
      "defaultValue": ""
    }
  },
  "metadata": {},
  "types": {},
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadWorkOrdersChain"
        }
      ]
    },
    "advance": {
      "chains": [
        {
          "chain": "advanceChain",
          "parameters": {
            "id": "{{ $current.data.id }}"
          }
        }
      ]
    },
    "viewInbox": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "inbox"
          }
        }
      ]
    },
    "searchChanged": {
      "chains": [
        {
          "chain": "searchWorkOrdersChain",
          "parameters": {
            "text": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "openRequest": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "requests",
            "requestId": "{{ $current.data.requestId }}",
            "view": "workflow"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-sp-smart-search-page": {
        "path": "oj-sp/smart-search-page/loader"
      },
      "oj-input-search": {
        "path": "ojs/ojinputsearch"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-progress-bar": {
        "path": "ojs/ojprogress-bar"
      }
    }
  }
}
