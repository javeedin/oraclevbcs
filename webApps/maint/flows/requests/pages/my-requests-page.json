{
  "title": "Requests",
  "description": "Redwood smart search page: search, status and scope filters, the requests table and a general drawer with the approval route and timeline",
  "variables": {
    "all": {
      "type": "object[]",
      "defaultValue": []
    },
    "requestsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "keyAttributes": "id",
        "itemType": "RequestRowType"
      }
    },
    "search": {
      "type": "string",
      "defaultValue": ""
    },
    "searchText": {
      "type": "string",
      "defaultValue": ""
    },
    "statusFilter": {
      "type": "string",
      "defaultValue": "All"
    },
    "scope": {
      "type": "string",
      "defaultValue": "all"
    },
    "statusOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "keyAttributes": "value",
        "itemType": "OptionType"
      }
    },
    "shownCount": {
      "type": "number",
      "defaultValue": 0
    },
    "draftCount": {
      "type": "number",
      "defaultValue": 0
    },
    "selected": {
      "type": "object",
      "defaultValue": {
        "route": [],
        "history": []
      }
    },
    "detailOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "columns": {
      "type": "object[]",
      "defaultValue": [
        {
          "headerText": "Request",
          "field": "id",
          "template": "requestTemplate",
          "sortable": "auto"
        },
        {
          "headerText": "Equipment",
          "field": "equipmentName",
          "template": "equipmentTemplate",
          "sortable": "auto"
        },
        {
          "headerText": "Priority",
          "field": "priority",
          "template": "priorityTemplate",
          "sortable": "auto"
        },
        {
          "headerText": "Status",
          "field": "status",
          "template": "statusTemplate",
          "sortable": "auto"
        },
        {
          "headerText": "Raised",
          "field": "requestedOn",
          "template": "raisedTemplate",
          "sortable": "auto"
        },
        {
          "headerText": "Needed by",
          "field": "neededBy",
          "template": "neededTemplate",
          "sortable": "auto"
        },
        {
          "headerText": "Next step",
          "field": "waitingFor",
          "template": "nextTemplate",
          "sortable": "disabled"
        }
      ]
    }
  },
  "metadata": {},
  "types": {
    "RequestRowType": {
      "id": "string",
      "title": "string",
      "equipmentName": "string",
      "location": "string",
      "priority": "string",
      "status": "string",
      "requestedBy": "string",
      "requestedOn": "string",
      "neededBy": "string",
      "waitingFor": "string",
      "workOrderId": "string"
    },
    "OptionType": {
      "value": "string",
      "label": "string"
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadRequestsChain"
        }
      ]
    },
    "createRequest": {
      "chains": [
        {
          "chain": "openPageChain",
          "parameters": {
            "page": "raise-request"
          }
        }
      ]
    },
    "sendForApproval": {
      "chains": [
        {
          "chain": "openPageChain",
          "parameters": {
            "page": "send-approval"
          }
        }
      ]
    },
    "searchChanged": {
      "chains": [
        {
          "chain": "filterRequestsChain",
          "parameters": {
            "text": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "statusChanged": {
      "chains": [
        {
          "chain": "filterRequestsChain",
          "parameters": {
            "status": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "scopeChanged": {
      "chains": [
        {
          "chain": "filterRequestsChain",
          "parameters": {
            "scope": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "openRequest": {
      "chains": [
        {
          "chain": "openRequestChain",
          "parameters": {
            "id": "{{ $current.row.id }}"
          }
        }
      ]
    },
    "closeDetail": {
      "chains": [
        {
          "chain": "closeDetailChain"
        }
      ]
    },
    "sendSelected": {
      "chains": [
        {
          "chain": "sendNowChain",
          "parameters": {
            "id": "{{ $variables.selected.id }}"
          }
        }
      ]
    },
    "openWorkOrders": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "workorders"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-sp-smart-search-page": {
        "path": "oj-sp/smart-search-page/loader"
      },
      "oj-sp-general-drawer-template": {
        "path": "oj-sp/general-drawer-template/loader"
      },
      "oj-input-search": {
        "path": "ojs/ojinputsearch"
      },
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      },
      "oj-buttonset-one": {
        "path": "ojs/ojbutton"
      },
      "oj-option": {
        "path": "ojs/ojoption"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      },
      "oj-drawer-popup": {
        "path": "ojs/ojdrawerpopup"
      }
    }
  }
}
