{
  "title": "Approval inbox",
  "description": "Redwood smart search page: act as an approver role, search what waits for it, approve or reject with a reason",
  "variables": {
    "role": {
      "type": "string",
      "defaultValue": "supervisor",
      "persisted": "history"
    },
    "roleTabs": {
      "type": "object[]",
      "defaultValue": []
    },
    "items": {
      "type": "object[]",
      "defaultValue": []
    },
    "rejectId": {
      "type": "string",
      "defaultValue": ""
    },
    "rejectTitle": {
      "type": "string",
      "defaultValue": ""
    },
    "rejectComment": {
      "type": "string",
      "defaultValue": ""
    },
    "rejectError": {
      "type": "string",
      "defaultValue": ""
    },
    "search": {
      "type": "string",
      "defaultValue": ""
    },
    "searchText": {
      "type": "string",
      "defaultValue": ""
    },
    "allItems": {
      "type": "object[]",
      "defaultValue": []
    }
  },
  "metadata": {},
  "types": {},
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadInboxChain"
        }
      ]
    },
    "approve": {
      "chains": [
        {
          "chain": "decideChain",
          "parameters": {
            "id": "{{ $current.data.id }}",
            "approve": true
          }
        }
      ]
    },
    "reject": {
      "chains": [
        {
          "chain": "openRejectChain",
          "parameters": {
            "id": "{{ $current.data.id }}",
            "title": "{{ $current.data.title }}"
          }
        }
      ]
    },
    "confirmReject": {
      "chains": [
        {
          "chain": "decideChain",
          "parameters": {
            "id": "{{ $variables.rejectId }}",
            "approve": false,
            "comment": "{{ $variables.rejectComment }}"
          }
        }
      ]
    },
    "cancelReject": {
      "chains": [
        {
          "chain": "closeRejectChain"
        }
      ]
    },
    "viewRequests": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "requests"
          }
        }
      ]
    },
    "roleChanged": {
      "chains": [
        {
          "chain": "loadInboxChain",
          "parameters": {
            "roleId": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "searchChanged": {
      "chains": [
        {
          "chain": "searchInboxChain",
          "parameters": {
            "text": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "openRequest": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "requests",
            "requestId": "{{ $current.data.id }}"
          }
        }
      ]
    },
    "openWorkflow": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "requests",
            "requestId": "{{ $current.data.id }}",
            "view": "workflow"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-sp-smart-search-page": {
        "path": "oj-sp/smart-search-page/loader"
      },
      "oj-input-search": {
        "path": "ojs/ojinputsearch"
      },
      "oj-buttonset-one": {
        "path": "ojs/ojbutton"
      },
      "oj-option": {
        "path": "ojs/ojoption"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-dialog": {
        "path": "ojs/ojdialog"
      },
      "oj-text-area": {
        "path": "ojs/ojinputtext"
      }
    }
  }
}
