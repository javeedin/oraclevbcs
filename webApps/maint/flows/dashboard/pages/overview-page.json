{
  "title": "Dashboard",
  "description": "Redwood dashboard landing page: a scoreboard of five KPIs, and a dashboard grid of panels for the selected KPI",
  "variables": {
    "model": {
      "type": "object",
      "defaultValue": {
        "kpis": [],
        "statusPoints": [],
        "weeklyPoints": [],
        "health": [],
        "healthPoints": [],
        "attention": [],
        "upcomingPm": [],
        "overduePm": [],
        "recent": [],
        "approverPoints": [],
        "waitingLongest": [],
        "downList": [],
        "woPoints": [],
        "woActive": [],
        "totalRequests": 0,
        "totalWorkOrders": 0,
        "down": 0,
        "pending": 0,
        "pmDue": 0,
        "pmOverdue": 0
      }
    },
    "kpis": {
      "type": "object[]",
      "defaultValue": []
    },
    "kpisADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "data": "{{ $variables.kpis }}",
        "itemType": "object",
        "keyAttributes": "id"
      }
    },
    "selectedKpi": {
      "type": "string",
      "defaultValue": "open"
    },
    "subtitle": {
      "type": "string",
      "defaultValue": ""
    },
    "statusADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "keyAttributes": "id",
        "itemType": "ChartPointType"
      }
    },
    "weeklyADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "keyAttributes": "id",
        "itemType": "ChartPointType"
      }
    },
    "approverADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "keyAttributes": "id",
        "itemType": "ChartPointType"
      }
    },
    "healthADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "keyAttributes": "id",
        "itemType": "ChartPointType"
      }
    },
    "woADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "keyAttributes": "id",
        "itemType": "ChartPointType"
      }
    }
  },
  "metadata": {},
  "types": {
    "ChartPointType": {
      "id": "string",
      "series": "string",
      "group": "string",
      "value": "number",
      "color": "string"
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadOverviewChain"
        }
      ]
    },
    "openRequest": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "requests",
            "requestId": "{{ $current.data.id }}"
          }
        }
      ]
    },
    "openRequests": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "requests"
          }
        }
      ]
    },
    "openInbox": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "inbox"
          }
        }
      ]
    },
    "openEquipment": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "equipment"
          }
        }
      ]
    },
    "openWorkOrders": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "workorders"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-sp-dashboard-landing-page": {
        "path": "oj-sp/dashboard-landing-page/loader"
      },
      "oj-sp-scoreboard": {
        "path": "oj-sp/scoreboard/loader"
      },
      "oj-sp-dashboard-grid": {
        "path": "oj-sp/dashboard-grid/loader"
      },
      "oj-sp-dashboard-panel": {
        "path": "oj-sp/dashboard-panel/loader"
      },
      "oj-switcher": {
        "path": "ojs/ojswitcher"
      },
      "oj-defer": {
        "path": "ojs/ojdefer"
      },
      "oj-chart": {
        "path": "ojs/ojchart"
      },
      "oj-chart-item": {
        "path": "ojs/ojchart"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-progress-bar": {
        "path": "ojs/ojprogress-bar"
      }
    }
  }
}
