{
  "title": "Home",
  "description": "Redwood welcome page: greeting banner with the main actions, compact counters, what needs attention, latest requests and Auto Pilot shortcuts",
  "variables": {
    "pageTitle": {
      "type": "string",
      "defaultValue": "Welcome"
    },
    "overline": {
      "type": "string",
      "defaultValue": ""
    },
    "summary": {
      "type": "string",
      "defaultValue": "Loading the latest maintenance picture..."
    },
    "tiles": {
      "type": "object[]",
      "defaultValue": []
    },
    "attention": {
      "type": "object[]",
      "defaultValue": []
    },
    "recent": {
      "type": "object[]",
      "defaultValue": []
    },
    "askChips": {
      "type": "object[]",
      "defaultValue": []
    }
  },
  "metadata": {},
  "types": {},
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadHomeChain"
        }
      ]
    },
    "welcomePrimaryAction": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "requests",
            "page": "raise-request"
          }
        }
      ]
    },
    "welcomeSecondaryAction": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "equipment"
          }
        }
      ]
    },
    "openTile": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "{{ $current.data.flow }}",
            "page": "{{ $current.data.page }}"
          }
        }
      ]
    },
    "openAttention": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "{{ $current.data.flow }}",
            "page": "{{ $current.data.page }}",
            "requestId": "{{ $current.data.requestId }}"
          }
        }
      ]
    },
    "openRecent": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "requests",
            "requestId": "{{ $current.data.id }}"
          }
        }
      ]
    },
    "openRecentWorkflow": {
      "chains": [
        {
          "chain": "goToChain",
          "parameters": {
            "flow": "requests",
            "requestId": "{{ $current.data.id }}",
            "view": "workflow"
          }
        }
      ]
    },
    "askAutopilot": {
      "chains": [
        {
          "chain": "askAutopilotChain",
          "parameters": {
            "prompt": "{{ $current.data.prompt }}"
          }
        }
      ]
    },
    "openAutopilot": {
      "chains": [
        {
          "chain": "askAutopilotChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-sp-welcome-page": {
        "path": "oj-sp/welcome-page/loader"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      }
    }
  }
}
