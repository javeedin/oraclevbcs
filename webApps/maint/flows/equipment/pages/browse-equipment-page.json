{
  "title": "Equipment",
  "description": "Redwood smart search page: search, category and status filters, object cards or a table, and a general drawer with specs and history",
  "variables": {
    "all": {
      "type": "object[]",
      "defaultValue": []
    },
    "shown": {
      "type": "object[]",
      "defaultValue": []
    },
    "tableADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "keyAttributes": "id",
        "itemType": "EquipmentRowType"
      }
    },
    "search": {
      "type": "string",
      "defaultValue": ""
    },
    "searchText": {
      "type": "string",
      "defaultValue": ""
    },
    "category": {
      "type": "string",
      "defaultValue": "All"
    },
    "status": {
      "type": "string",
      "defaultValue": "all"
    },
    "view": {
      "type": "string",
      "defaultValue": "cards",
      "persisted": "history"
    },
    "categoryOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "keyAttributes": "value",
        "itemType": "OptionType"
      }
    },
    "stats": {
      "type": "object",
      "defaultValue": {
        "total": 0,
        "running": 0,
        "maintenance": 0,
        "down": 0
      }
    },
    "subtitle": {
      "type": "string",
      "defaultValue": ""
    },
    "selected": {
      "type": "object",
      "defaultValue": {}
    },
    "history": {
      "type": "object[]",
      "defaultValue": []
    },
    "detailOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "columns": {
      "type": "object[]",
      "defaultValue": [
        {
          "headerText": "Asset",
          "field": "name",
          "template": "assetTemplate",
          "sortable": "auto"
        },
        {
          "headerText": "Category",
          "field": "category",
          "sortable": "auto"
        },
        {
          "headerText": "Location",
          "field": "location",
          "sortable": "auto"
        },
        {
          "headerText": "Status",
          "field": "status",
          "template": "statusTemplate",
          "sortable": "auto"
        },
        {
          "headerText": "Health",
          "field": "health",
          "template": "healthTemplate",
          "sortable": "auto"
        },
        {
          "headerText": "Next PM",
          "field": "nextPm",
          "template": "pmTemplate",
          "sortable": "auto"
        },
        {
          "headerText": "",
          "field": "id",
          "template": "actionTemplate",
          "sortable": "disabled",
          "className": "oj-helper-text-align-end"
        }
      ]
    },
    "shownCount": {
      "type": "number",
      "defaultValue": 0
    }
  },
  "metadata": {},
  "types": {
    "EquipmentRowType": {
      "id": "string",
      "name": "string",
      "category": "string",
      "location": "string",
      "status": "string",
      "health": "number",
      "nextPm": "string",
      "pmState": "string",
      "criticality": "string",
      "openRequests": "number",
      "manufacturer": "string",
      "model": "string",
      "pmDays": "number"
    },
    "OptionType": {
      "value": "string",
      "label": "string"
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadEquipmentChain"
        }
      ]
    },
    "searchChanged": {
      "chains": [
        {
          "chain": "filterEquipmentChain",
          "parameters": {
            "text": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "categoryChanged": {
      "chains": [
        {
          "chain": "filterEquipmentChain",
          "parameters": {
            "category": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "statusChanged": {
      "chains": [
        {
          "chain": "filterEquipmentChain",
          "parameters": {
            "status": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "clearFilters": {
      "chains": [
        {
          "chain": "filterEquipmentChain",
          "parameters": {
            "reset": true
          }
        }
      ]
    },
    "openRow": {
      "chains": [
        {
          "chain": "openEquipmentChain",
          "parameters": {
            "id": "{{ $current.row.id }}"
          }
        }
      ]
    },
    "raiseFromDetail": {
      "chains": [
        {
          "chain": "raiseForEquipmentChain",
          "parameters": {
            "id": "{{ $variables.selected.id }}"
          }
        }
      ]
    },
    "closeDetail": {
      "chains": [
        {
          "chain": "closeDetailChain"
        }
      ]
    },
    "openCard": {
      "chains": [
        {
          "chain": "openEquipmentChain",
          "parameters": {
            "id": "{{ $current.data.id }}"
          }
        }
      ]
    },
    "raiseFromRow": {
      "chains": [
        {
          "chain": "raiseForEquipmentChain",
          "parameters": {
            "id": "{{ $current.row.id }}"
          }
        }
      ]
    },
    "raiseRequest": {
      "chains": [
        {
          "chain": "raiseForEquipmentChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-sp-smart-search-page": {
        "path": "oj-sp/smart-search-page/loader"
      },
      "oj-sp-general-drawer-template": {
        "path": "oj-sp/general-drawer-template/loader"
      },
      "oj-input-search": {
        "path": "ojs/ojinputsearch"
      },
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-buttonset-one": {
        "path": "ojs/ojbutton"
      },
      "oj-option": {
        "path": "ojs/ojoption"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      },
      "oj-drawer-popup": {
        "path": "ojs/ojdrawerpopup"
      },
      "oj-progress-bar": {
        "path": "ojs/ojprogress-bar"
      }
    }
  }
}
