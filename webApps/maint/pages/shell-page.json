{
  "description": "Application shell on Oracle's Redwood templates: pillar theme, app header, Redwood in-app navigation, toast messages, the router, and the Auto Pilot (Claude) panel with its settings.",
  "routerFlow": "home",
  "variables": {
    "navigationList": {
      "type": "navigationType[]",
      "defaultValue": [
        {
          "id": "home",
          "icon": "oj-ux-ico-home",
          "label": "Home"
        },
        {
          "id": "dashboard",
          "icon": "oj-ux-ico-dashboard",
          "label": "Dashboard"
        },
        {
          "id": "requests",
          "icon": "oj-ux-ico-content-item-search",
          "label": "Requests"
        },
        {
          "id": "equipment",
          "icon": "oj-ux-ico-box",
          "label": "Equipment"
        },
        {
          "id": "inbox",
          "icon": "oj-ux-ico-employee",
          "label": "Approvals"
        },
        {
          "id": "workorders",
          "icon": "oj-ux-ico-calendar",
          "label": "Work orders"
        }
      ]
    },
    "navigationADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "data": "{{ $variables.navigationList }}",
        "itemType": "navigationType",
        "keyAttributes": "id"
      }
    },
    "apChat": {
      "type": "object[]",
      "defaultValue": []
    },
    "apHistory": {
      "type": "any",
      "defaultValue": []
    },
    "apPrompt": {
      "type": "string",
      "defaultValue": ""
    },
    "apBusy": {
      "type": "boolean",
      "defaultValue": false
    },
    "apSuggestions": {
      "type": "object[]",
      "defaultValue": []
    },
    "apSettings": {
      "type": "object",
      "defaultValue": {
        "hasKey": false,
        "keyHint": "",
        "model": "",
        "modelLabel": "",
        "remember": true,
        "useData": true,
        "desktop": false,
        "keyStore": "this browser"
      }
    },
    "apForm": {
      "type": "object",
      "defaultValue": {
        "apiKey": "",
        "model": "claude-sonnet-5-5",
        "remember": true,
        "useData": true
      }
    },
    "apModelsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "keyAttributes": "value",
        "itemType": "optionType"
      }
    },
    "apStatus": {
      "type": "string",
      "defaultValue": ""
    },
    "apStatusOk": {
      "type": "boolean",
      "defaultValue": false
    },
    "apTesting": {
      "type": "boolean",
      "defaultValue": false
    },
    "pendingCount": {
      "type": "number",
      "defaultValue": 0
    },
    "toasts": {
      "type": "object[]",
      "defaultValue": []
    },
    "apOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "desktop": {
      "type": "object",
      "defaultValue": {
        "isDesktop": false,
        "version": "",
        "platform": "",
        "source": ""
      }
    },
    "appVersion": {
      "type": "object",
      "defaultValue": {
        "version": "",
        "label": "",
        "title": ""
      }
    }
  },
  "metadata": {},
  "types": {
    "navigationType": {
      "id": "string",
      "icon": "string",
      "label": "string"
    },
    "optionType": {
      "value": "string",
      "label": "string"
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "initShellChain"
        }
      ]
    },
    "navigationSelection": {
      "chains": [
        {
          "chain": "navigateChain",
          "parameters": {
            "flow": "{{ $event.detail.currentId }}"
          }
        }
      ]
    },
    "goHome": {
      "chains": [
        {
          "chain": "navigateChain",
          "parameters": {
            "flow": "home"
          }
        }
      ]
    },
    "bellClick": {
      "chains": [
        {
          "chain": "navigateChain",
          "parameters": {
            "flow": "inbox"
          }
        }
      ]
    },
    "resetDemo": {
      "chains": [
        {
          "chain": "resetDemoChain"
        }
      ]
    },
    "openAutopilot": {
      "chains": [
        {
          "chain": "toggleAutopilotChain",
          "parameters": {
            "open": true
          }
        }
      ]
    },
    "closeAutopilot": {
      "chains": [
        {
          "chain": "toggleAutopilotChain",
          "parameters": {
            "open": false
          }
        }
      ]
    },
    "autopilotOpenedChanged": {
      "chains": [
        {
          "chain": "autopilotSendChain",
          "parameters": {
            "opened": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "sendPrompt": {
      "chains": [
        {
          "chain": "autopilotSendChain"
        }
      ]
    },
    "promptKeydown": {
      "chains": [
        {
          "chain": "autopilotSendChain",
          "parameters": {
            "key": "{{ $event.key }}",
            "ctrl": "{{ $event.ctrlKey || $event.metaKey }}"
          }
        }
      ]
    },
    "askSuggestion": {
      "chains": [
        {
          "chain": "autopilotSendChain",
          "parameters": {
            "text": "{{ $current.data.prompt }}"
          }
        }
      ]
    },
    "newChat": {
      "chains": [
        {
          "chain": "newChatChain"
        }
      ]
    },
    "openSettings": {
      "chains": [
        {
          "chain": "autopilotSettingsChain",
          "parameters": {
            "action": "open"
          }
        }
      ]
    },
    "saveSettings": {
      "chains": [
        {
          "chain": "autopilotSettingsChain",
          "parameters": {
            "action": "save"
          }
        }
      ]
    },
    "testSettings": {
      "chains": [
        {
          "chain": "autopilotSettingsChain",
          "parameters": {
            "action": "test"
          }
        }
      ]
    },
    "removeKey": {
      "chains": [
        {
          "chain": "autopilotSettingsChain",
          "parameters": {
            "action": "remove"
          }
        }
      ]
    },
    "closeSettings": {
      "chains": [
        {
          "chain": "autopilotSettingsChain",
          "parameters": {
            "action": "close"
          }
        }
      ]
    },
    "bridgeCounts": {
      "chains": [
        {
          "chain": "shellBridgeChain",
          "parameters": {
            "type": "counts",
            "detail": "{{ $event.detail }}"
          }
        }
      ]
    },
    "bridgeToast": {
      "chains": [
        {
          "chain": "shellBridgeChain",
          "parameters": {
            "type": "toast",
            "detail": "{{ $event.detail }}"
          }
        }
      ]
    },
    "bridgeCommand": {
      "chains": [
        {
          "chain": "shellBridgeChain",
          "parameters": {
            "type": "command",
            "detail": "{{ $event.detail }}"
          }
        }
      ]
    },
    "bridgeAsk": {
      "chains": [
        {
          "chain": "autopilotSendChain",
          "parameters": {
            "ask": "{{ $event.detail }}"
          }
        }
      ]
    },
    "downloadDesktop": {
      "chains": [
        {
          "chain": "downloadDesktopChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-sp-pillar-theme": {
        "path": "oj-sp/pillar-theme/loader"
      },
      "oj-sp-in-app-navigation": {
        "path": "oj-sp/in-app-navigation/loader"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-avatar": {
        "path": "ojs/ojavatar"
      },
      "oj-messages": {
        "path": "ojs/ojmessages"
      },
      "oj-drawer-popup": {
        "path": "ojs/ojdrawerpopup"
      },
      "oj-dialog": {
        "path": "ojs/ojdialog"
      },
      "oj-text-area": {
        "path": "ojs/ojinputtext"
      },
      "oj-input-password": {
        "path": "ojs/ojinputtext"
      },
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      },
      "oj-switch": {
        "path": "ojs/ojswitch"
      },
      "oj-form-layout": {
        "path": "ojs/ojformlayout"
      },
      "oj-progress-bar": {
        "path": "ojs/ojprogress-bar"
      }
    }
  },
  "translations": {}
}
