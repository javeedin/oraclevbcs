{
  "description": "Application shell on Oracle's Redwood templates: pillar theme, app header, Redwood in-app navigation, toast messages and the router that shows the module flows.",
  "routerFlow": "home",
  "variables": {
    "navigationList": {
      "type": "navigationType[]",
      "defaultValue": [
        {
          "id": "home",
          "icon": "oj-ux-ico-home",
          "label": "Home"
        },
        {
          "id": "dashboard",
          "icon": "oj-ux-ico-dashboard",
          "label": "Dashboard"
        },
        {
          "id": "requests",
          "icon": "oj-ux-ico-content-item-search",
          "label": "Requests"
        },
        {
          "id": "equipment",
          "icon": "oj-ux-ico-box",
          "label": "Equipment"
        },
        {
          "id": "inbox",
          "icon": "oj-ux-ico-employee",
          "label": "Approvals"
        },
        {
          "id": "workorders",
          "icon": "oj-ux-ico-calendar",
          "label": "Work orders"
        }
      ]
    },
    "navigationADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "data": "{{ $variables.navigationList }}",
        "itemType": "navigationType",
        "keyAttributes": "id"
      }
    }
  },
  "metadata": {},
  "types": {
    "navigationType": {
      "id": "string",
      "icon": "string",
      "label": "string"
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "initShellChain"
        }
      ]
    },
    "navigationSelection": {
      "chains": [
        {
          "chain": "navigateChain",
          "parameters": {
            "flow": "{{ $event.detail.currentId }}"
          }
        }
      ]
    },
    "goHome": {
      "chains": [
        {
          "chain": "navigateChain",
          "parameters": {
            "flow": "home"
          }
        }
      ]
    },
    "bellClick": {
      "chains": [
        {
          "chain": "navigateChain",
          "parameters": {
            "flow": "inbox"
          }
        }
      ]
    },
    "resetDemo": {
      "chains": [
        {
          "chain": "resetDemoChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-sp-pillar-theme": {
        "path": "oj-sp/pillar-theme/loader"
      },
      "oj-sp-in-app-navigation": {
        "path": "oj-sp/in-app-navigation/loader"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-avatar": {
        "path": "ojs/ojavatar"
      },
      "oj-messages": {
        "path": "ojs/ojmessages"
      }
    }
  },
  "translations": {}
}
